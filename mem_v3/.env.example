# ==============================================================================
# MEM ORCHESTRATOR — CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================
# Instruções de Uso:
# 1. Copie este arquivo para um novo arquivo chamado `.env`:
#      Linux/macOS/WSL: cp .env.example .env
#      PowerShell:      Copy-Item .env.example .env
# 2. Preencha os valores desejados abaixo.
# 3. O arquivo `.env` NUNCA é enviado para o GitHub (protegido pelo .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONSULTOR EXECUTIVO IA (OPCIONAL / OPTIONAL)
# ------------------------------------------------------------------------------
# Se configurada, o MEM Orchestrator consulta o modelo para propor ajustes finos
# de hiperparâmetros (taxa de aprendizado, gradient clipping e loss scale).
# O LocalPolicyEngine avalia e filtra todas as diretivas com regras de segurança.
# Se DEIXADA EM BRANCO, o motor opera em MODO 100% AUTÔNOMO E LOCAL (sem chamadas externas).
OPENAI_API_KEY=

# Timeout em segundos para requisições da API externa (padrão: 8)
MEM_V89_API_TIMEOUT_SECONDS=8

# ------------------------------------------------------------------------------
# 2. DATASET E CACHE MEMMAP (OPCIONAL / DEFAULT EMBUTIDO)
# ------------------------------------------------------------------------------
# Modo de cache para streaming de tokens: "memmap", "disk" ou "off" (padrão: memmap)
MEM_DATASET_CACHE_MODE=memmap

# Diretório onde os arquivos de tokens pré-processados (.bin) são armazenados
MEM_DATASET_CACHE_DIR=dataset_cache

# Quantidade de batches pré-carregados na memória RAM (padrão: 12)
MEM_DATASET_PREFETCH_BATCHES=12

# ------------------------------------------------------------------------------
# 3. HARDWARE & DISPOSITIVO CUDA (OPCIONAL)
# ------------------------------------------------------------------------------
# Índice da GPU física a ser utilizada (ex: 0 para primeira placa)
CUDA_VISIBLE_DEVICES=0
